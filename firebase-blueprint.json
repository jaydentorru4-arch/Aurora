{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile authenticated with Google.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Google Auth user ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "format": "email",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User Google profile avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "format": "date-time"
        }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User chat session with Aurora.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner Google Auth UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Conversation title",
          "maxLength": 256
        },
        "createdAt": {
          "type": "number",
          "description": "Epoch timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch timestamp"
        }
      },
      "required": ["id", "userId", "title"]
    },
    "Message": {
      "title": "Message",
      "description": "A message turn inside a conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner Google Auth UID",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Sender role",
          "enum": ["user", "model"]
        },
        "content": {
          "type": "string",
          "description": "Message content",
          "maxLength": 65536
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch millisecond timestamp"
        }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Personal user profiles"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User conversation sessions"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside a conversation"
    }
  }
}
