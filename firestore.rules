rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for User profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // Validation helper for Conversation
    function isValidConversation(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId == userId
        && data.title is string && data.title.size() <= 256;
    }

    // Validation helper for Message
    function isValidMessage(data, userId, conversationId) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp'])
        && data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp', 'sources', 'image', 'error'])
        && data.id is string && isValidId(data.id)
        && data.conversationId == conversationId
        && data.userId == userId
        && (data.role == 'user' || data.role == 'model')
        && data.content is string && data.content.size() <= 65536
        && data.timestamp is number;
    }

    // User document rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's private conversation sessions
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversationId)
          && isValidConversation(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(conversationId)
          && isValidConversation(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

        // Messages within a conversation
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
          allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId)
            && isValidMessage(incoming(), userId, conversationId);
          allow update: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId)
            && isValidMessage(incoming(), userId, conversationId)
            && incoming().userId == existing().userId
            && incoming().conversationId == existing().conversationId;
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }
    }

    // Test connection path for initial verification
    match /test/connection {
      allow read: if true;
    }
  }
}
